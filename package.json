{
  "name": "secret-side",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:push:dev": "node scripts/db.mjs push dev",
    "db:push:live": "node scripts/db.mjs push live",
    "db:types": "node scripts/db.mjs types",
    "content:import": "tsx --conditions=react-server scripts/import-content.ts",
    "verify:live": "tsx --conditions=react-server scripts/verify-live.ts",
    "field:report": "tsx --conditions=react-server scripts/field-report.ts",
    "predev": "node scripts/copy-map-worker.mjs",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "map:style": "node scripts/build-map-style.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}

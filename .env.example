# Copy to .env.local and fill in. Never commit .env.local or .env.live.local.
# .env.local always points at the DEV Supabase project (secret-side-dev).

# --- Supabase, dev project (Project Settings → API Keys) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://rekuyorpqcszmwkiwcsz.supabase.co
# Publishable key (sb_publishable_…). Safe in the browser; RLS limits what it can read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). SERVER ONLY: bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# --- Tools on your PC only (never in Vercel) --------------------------------
# Dev database, Session pooler connection string (Connect → Session pooler), with the
# dev database password filled in. Used by `npm run db:push:dev` and `npm run test:db`.
SUPABASE_DEV_DB_URL=
# Personal access token of the Secret Side Supabase account (Account → Access Tokens).
# Used by `npm run db:types`, so the CLI doesn't depend on whichever account it's logged in to.
SUPABASE_ACCESS_TOKEN=

# --- Session cookie (M1, removed in M2-4) -----------------------------------
# 32+ random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# --- .env.live.local (separate file, PC only) --------------------------------
# SUPABASE_LIVE_DB_URL=   live project (secret-side) Session pooler string, for `npm run db:push:live`
